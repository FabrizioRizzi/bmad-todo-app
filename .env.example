# === Local Dev (pnpm dev) ===
# Backend connects to Postgres exposed by the dev profile sidecar on localhost:5432
# Start with: pnpm dev  (runs docker compose --profile dev up -d db dev-db-access)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/bmad_todo
PORT=3000
NODE_ENV=development

# === Docker Compose Production ===
# DATABASE_URL is built at runtime by docker-entrypoint.sh from Docker secrets.
# The variables below configure PostgreSQL and compose services.
# Database credentials are read from Docker secrets files:
#   ./secrets/postgres_user.txt
#   ./secrets/postgres_password.txt
# Start with: docker compose up --build
POSTGRES_DB=bmad_todo
FRONTEND_PORT=8080

# Comma-separated browser origins (required when NODE_ENV=production)
ALLOWED_ORIGINS=http://localhost:8080
# Expose Swagger UI outside local/test only when explicitly enabled
ENABLE_DOCUMENTATION=false

# === Docker Compose Test Profile ===
# Isolated test database on port 5433 (never touches production data).
# Start with: docker compose --profile test up -d test-db
# Connect with: psql -h localhost -p 5433 -U postgres -d bmad_todo_test
DATABASE_URL_TEST=postgresql://postgres:postgres@localhost:5433/bmad_todo_test
