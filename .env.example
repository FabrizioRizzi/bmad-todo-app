# === Local Development ===
# Used when running the backend directly (pnpm dev)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/bmad_todo
PORT=3000
NODE_ENV=development

# === Docker Compose ===
# DATABASE_URL is set automatically in docker-compose.yml (uses 'db' hostname)
# The variables below configure PostgreSQL and compose services.
# Database credentials are read from Docker secrets files:
#   ./secrets/postgres_user.txt
#   ./secrets/postgres_password.txt
POSTGRES_DB=bmad_todo
FRONTEND_PORT=8080

# Comma-separated browser origins (required when NODE_ENV=production)
ALLOWED_ORIGINS=http://localhost:8080
