{
	"name": "bmad-todo-app",
	"private": true,
	"packageManager": "pnpm@10.33.0+sha512.10568bb4a6afb58c9eb3630da90cc9516417abebd3fabbe6739f0ae795728da1491e9db5a544c76ad8eb7570f5c4bb3d6c637b2cb41bfdcdb47fa823c8649319",
	"scripts": {
		"compose": "docker compose",
		"compose:up": "docker compose up --build",
		"compose:down": "docker compose down",
		"compose:dev:up": "docker compose --profile dev up -d db dev-db-access",
		"compose:dev:down": "docker compose --profile dev down",
		"compose:test:up": "docker compose --profile test up -d test-db",
		"compose:test:down": "docker compose --profile test down",
		"dev": "docker compose --profile dev up -d db dev-db-access && pnpm --parallel -r run dev",
		"dev:app": "pnpm --parallel -r run dev",
		"dev:down": "docker compose --profile dev down",
		"build": "pnpm -r run build",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"test": "pnpm -r run test",
		"test:e2e": "playwright test --config e2e/playwright.config.ts",
		"db:seed:demo": "pnpm --filter backend db:seed:demo",
		"prepare": "simple-git-hooks"
	},
	"simple-git-hooks": {
		"pre-commit": "pnpm biome check --staged --no-errors-on-unmatched"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"esbuild",
			"simple-git-hooks"
		]
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.11.1",
		"@biomejs/biome": "^2.4.10",
		"@playwright/test": "^1.59.1",
		"@types/node": "^25.5.2",
		"simple-git-hooks": "^2.13.1",
		"vitest": "^4.1.3"
	}
}
